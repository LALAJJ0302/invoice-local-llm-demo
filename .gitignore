.env
__pycache__/
*.pyc

# venv writes its own .gitignore containing '*', but do not rely on that file
# surviving. If it is ever removed the whole environment would be committed.
.venv/

workflow_platform.db
# Signing key for the login token in the page URL, created on first sign-in.
.session_secret
inbox/
archive/
*.pdf

.DS_Store
workflow_platform.db.bak-*

# Generated by generate_briefing_docx.py. Tracked binaries cannot be merged by git,
# so the generator is the source of truth, not the output.
Enterprise_AI_Workflow_Briefing.docx

# Generated by report/build-pdf.sh. Same reason the .docx is not tracked: git cannot
# merge a binary, and a PDF gets a new hash on every build even from identical markdown.
# The markdown is the source of truth; rebuild with ./report/build-pdf.sh
report/*.pdf

# Word writes a lock file beside any open .docx. It is transient and machine-local.
~$*

# Built documents. The markdown is the source of truth; a .docx gets a new hash on every
# build even from identical source, so git cannot merge it.
report/*.docx

# Design handoff artefacts, regenerated as needed
design-handoff/

# Stitch handoff, regenerated by scripts/build_stitch_handoff.py
stitch-handoff/

# Local Cursor plans. Not part of the project, and not for commit or push.
.cursor/plan/
.cursor/plans/
