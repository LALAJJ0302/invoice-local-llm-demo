# Copy this file to .env and fill in real values. Never commit .env itself (it is
# gitignored) and never share a screenshot that shows it.
#
#   cp .env.example .env

# Gmail IMAP, read by email_listener.py. Use a Gmail App Password, not your normal
# password: https://myaccount.google.com/apppasswords
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Where email_listener.py saves attachments. main.py reads from the same folder.
ATTACHMENT_DIR=./inbox

# Only used when running under docker-compose.yml: points the ollama Python client at the
# 'ollama' service instead of localhost. Leave unset for a bare-metal (non-Docker) run,
# where Ollama listens on localhost:11434 by default.
# OLLAMA_HOST=http://ollama:11434

# Jira Cloud task dispatch (optional). Read by task_dispatch.py after validation.
# Create an API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Find your accountId: GET https://YOUR-SITE.atlassian.net/rest/api/3/myself
# JIRA_ENABLED=true
# Must include https:// (or just the hostname — the client adds https:// if omitted).
# JIRA_BASE_URL=https://YOUR-SITE.atlassian.net
# JIRA_EMAIL=your_email@gmail.com
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_PROJECT_KEY=INV
# JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=712020:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Map Streamlit assignee names to Jira accountIds (JSON object):
# JIRA_ASSIGNEE_MAP={"Luke":"712020:...","Neo":"712020:...","JJ":"712020:..."}
#
# Post-create workflow status routing (must match Jira status names exactly).
# Run scripts/discover_jira_statuses.py after setting up the KAN workflow.
# JIRA_STATUS_AUTO_APPROVED=To Do (Auto Approved)
# JIRA_STATUS_HUMAN_REVIEWED=To Do (Human Reviewed)
# Optional: transition IDs instead of status names (see discover script output):
# JIRA_TRANSITION_AUTO_APPROVED=11
# JIRA_TRANSITION_HUMAN_REVIEWED=12

# Dashboard logins are rows in the users table. The dashboard inserts luke, neo
# and jj on startup when those usernames are missing (password changeme, then a
# required change). The shared Jira API user needs Modify Reporter so their
# account ids can be set as the issue reporter.
